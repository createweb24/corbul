# Baza de date PostgreSQL
# Dacă serverul local cere autentificare pe rol, adaugă utilizatorul:
#   postgresql://UTILIZATOR@localhost:5432/corbul?schema=public
DATABASE_URL=postgresql://localhost:5432/corbul?schema=public

# Autentificare panou de administrare (JWT, 7 zile).
# OBLIGATORIU în producție: ≥ 32 de octeți aleatori, ex. `openssl rand -hex 32`.
# Gol sau egal cu valoarea de rezervă ⇒ API-ul refuză să pornească cu NODE_ENV=production.
JWT_SECRET=

# Adresa aplicației web (CORS + URL-uri de redirect Stripe)
WEB_URL=http://localhost:3100

# Portul API-ului
PORT=4100

# Proxy-uri de încredere pentru X-Forwarded-For (Express „trust proxy").
# În spatele nginx/Cloudflare pune `1` (un salt) sau adresele proxy-ului,
# altfel rate-limit-ul pe IP vede doar IP-ul proxy-ului.
# loopback (implicit) | 1 | true | adrese/subrețele separate prin virgulă
TRUST_PROXY=loopback

# Stripe — lăsate ca placeholder: site-ul rulează în „mod demonstrativ"
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
